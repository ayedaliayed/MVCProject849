@using MVCProject849.Model_Views
@* @model MVCProject849.Models.Employee *@
@model createupadteemployee

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Employee</h1>

<form asp-controller="Empolyee" asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label" ></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" style="color:red"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Image" class="control-label"></label>
        <input asp-for="Image" class="form-control" />
        <span asp-validation-for="Image" style="color:red"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address" class="control-label"></label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" style="color:red"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Phone" class="control-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="DepartmentId" class="control-label"></label>
        <select asp-for="DepartmentId" class="form-control">
            <option value="">-- Select Department --</option>
            @if (ViewBag.Departments != null)
            {
                foreach (var d in ViewBag.Departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            }
        </select>
    </div>

    <div class="form-group">
        <input type="submit" value="Update" class="btn btn-primary" />
    </div>

</form>

